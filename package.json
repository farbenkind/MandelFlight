{
  "name": "mandelflight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "wasm:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src\\projekte\\fractal-demo\\build.ps1",
    "preview": "vite preview",
    "test": "node --test",
    "presets:import-legacy": "node scripts/import-legacy-presets.js",
    "cf:dev": "vite build && npx --yes wrangler@4 pages dev dist --kv PRESETS",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name mandelflight --branch main"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
